{
  "version": 1,
  "project": "accounting/blotter",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "originVar": "AUTH_ORIGIN",
  "publicSettings": ["MAIL_PROVIDER", "MAIL_FROM"],
  "vars": {
    "AUTH_LOCAL": "false",
    "MAIL_PROVIDER": "none",
    "MAIL_FROM": ""
  },
  "secrets": [
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "VAULT_KEY",
      "environment": "VAULT_KEY",
      "optional": true
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "MAIL_PROVIDER",
      "environment": "MAIL_PROVIDER",
      "optional": true
    },
    {
      "binding": "MAIL_FROM",
      "environment": "MAIL_FROM",
      "optional": true
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY",
      "optional": true
    }
  ]
}
